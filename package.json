{
  "name": "botzin",
  "version": "0.1.0",
  "private": true,
  "description": "Local TypeScript architecture for Tibia screen perception through OBS preview and optional Raspberry Pi HID execution.",
  "type": "module",
  "scripts": {
    "build": "npm run frontend:build && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "config:dev": "tsx --env-file-if-exists=.env src/web/config-server.ts",
    "dev": "tsx --env-file-if-exists=.env src/index.ts",
    "frontend:dev": "vite frontend",
    "frontend:build": "vite build frontend",
    "annotations:dev": "tsx scripts/annotation-server.ts",
    "frontend:typecheck": "tsc -p frontend/tsconfig.json --noEmit",
    "migrate": "tsx --env-file-if-exists=.env src/database/migrate.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "knowledge:ingest": "tsx --env-file-if-exists=.env src/knowledge/ingest-youtube.ts",
    "knowledge:ingest:whisper": "tsx --env-file-if-exists=.env src/knowledge/ingest-youtube.ts --whisper-missing",
    "knowledge:retry-failed": "tsx --env-file-if-exists=.env src/knowledge/ingest-youtube.ts --whisper-missing --retry-failed",
    "knowledge:video:prepare": "tsx --env-file-if-exists=.env src/knowledge/prepare-visual-training.ts",
    "knowledge:video:retry": "tsx --env-file-if-exists=.env src/knowledge/prepare-visual-training.ts --retry-failed",
    "knowledge:video:analyze": "tsx --env-file-if-exists=.env src/knowledge/analyze-visual-training.ts",
    "knowledge:video:train": "tsx --env-file-if-exists=.env src/knowledge/prepare-visual-training.ts --analyze-local",
    "knowledge:video:train:retry": "tsx --env-file-if-exists=.env src/knowledge/prepare-visual-training.ts --analyze-local --retry-failed",
    "ai:export": "tsx --env-file-if-exists=.env src/migration/export-ai.ts",
    "ai:import": "tsx --env-file-if-exists=.env src/migration/import-ai.ts",
    "knowledge:reindex": "tsx --env-file-if-exists=.env src/knowledge/ingest-youtube.ts --index-only",
    "knowledge:sync:tibia": "tsx --env-file-if-exists=.env src/learning/sync-tibia-general-knowledge.ts",
    "books:translate": "tsx --env-file-if-exists=.env src/learning/sync-tibia-book-translations.ts",
    "skills:sync": "tsx --env-file-if-exists=.env src/learning/sync-tibia-spells.ts",
    "catalog:sync": "tsx --env-file-if-exists=.env src/learning/sync-tibia-game-catalog.ts",
    "creatures:sync": "tsx --env-file-if-exists=.env src/learning/sync-tibia-game-catalog.ts --creatures-only",
    "creatures:train": "python scripts/train-creature-detector.py",
    "entities:dataset:clean": "python scripts/build-clean-entity-dataset.py",
    "entities:dataset:human": "python scripts/build-clean-entity-dataset.py --human-annotations --force",
    "entities:validate:clean": "python scripts/validate-clean-entity-sources.py",
    "entities:train:clean": "python scripts/train-clean-entity-detector.py",
    "entities:resume:clean": "python scripts/resume-clean-entity-training.py",
    "rules:seed:vocation": "tsx --env-file-if-exists=.env src/learning/seed-vocation-skill-rules-cli.ts",
    "items:sync": "tsx --env-file-if-exists=.env src/learning/sync-tibia-game-catalog.ts --items-only",
    "items:assets": "tsx --env-file-if-exists=.env src/knowledge/import-item-assets.ts",
    "user:create-admin": "tsx --env-file-if-exists=.env src/database/create-admin-user.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "supervisor": "tsx --env-file-if-exists=.env scripts/supervisor.ts",
    "vault:export": "tsx --env-file-if-exists=.env scripts/export-obsidian-vault.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/busboy": "^1.5.4",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "0.468.0",
    "mysql2": "^3.14.0",
    "obs-websocket-js": "^5.0.8",
    "onnxruntime-node": "1.21.1",
    "prisma": "^6.19.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "happy-dom": "20.10.6",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
